# Template for sebi.env — copy this to `sebi.env` and fill in real values.
#
# Used by docker-compose in two ways:
#   1. `env_file: - sebi.env` (per service) → injected into the container.
#      Backend reads via its Go config loader; frontend nginx reads via
#      envsubst on /etc/nginx/templates/*.template.
#   2. `--env-file sebi.env` (CLI flag) → ${VAR} interpolation inside
#      docker-compose.yml (ports, container_name).
#
# Bring the stack up with:
#     docker compose --env-file sebi.env up -d

# ── Shared: ports & inter-container hostnames ────────────────────────────────
FRONTEND_PORT=3000
BACKEND_HOST=sebi-crud

# ── Backend: application ─────────────────────────────────────────────────────
ENV=prod
HTTP_PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s

# ── Backend: MongoDB ─────────────────────────────────────────────────────────
# Point at whichever Mongo this VM should use. If Mongo runs on a separate
# infra VM (typical), use that VM's IP directly — the container reaches it
# over the docker bridge.
MONGO_URI=mongodb://<user>:<pass>@<mongo-host>:27017/?socketTimeoutMS=300000&connectTimeoutMS=30000&serverSelectionTimeoutMS=300000&maxPoolSize=20
MONGO_DB=SEBI-project

# ── Backend: JWT (HS256, secret MUST be >= 32 bytes) ─────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-real-secret-of-at-least-32-bytes
JWT_ISSUER=sebi-crud
JWT_TTL=24h

# ── Backend: System-to-system shared secret (>= 32 bytes when set) ───────────
# Generate: openssl rand -base64 48
# When set, callers presenting `X-System-Key: <value>` bypass JWT + role
# checks on every /v1 endpoint. Leave empty to disable.
SYSTEM_API_KEY=

# ── Backend: CORS ────────────────────────────────────────────────────────────
# Exact origins the browser loads the SEBI frontend from. No "*" when ENV=prod.
CORS_ORIGINS=http://localhost:3000,http://<vm-host-or-ip>:3000

# ── Backend: pagination ──────────────────────────────────────────────────────
COMPLAINTS_PAGE_DEFAULT=50
COMPLAINTS_PAGE_MAX=200
ENTITIES_PAGE_DEFAULT=20
ENTITIES_PAGE_MAX=100
ENTITY_LIST_PAGE_DEFAULT=50
ENTITY_LIST_PAGE_MAX=200
