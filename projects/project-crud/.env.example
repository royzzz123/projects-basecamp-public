# Application
ENV=dev                          # dev | staging | prod
HTTP_PORT=8080
LOG_LEVEL=info                   # debug | info | warn | error
SHUTDOWN_TIMEOUT=15s

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=sebi_crud

# JWT (HS256). Secret MUST be >= 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-secret-of-at-least-32-bytes
JWT_ISSUER=sebi-crud
JWT_TTL=24h

# Service-to-service shared secret. When set (>= 32 bytes), any request with
# the header `X-System-Key: <value>` bypasses JWT auth and role checks for
# every /v1 endpoint. Leave empty to disable the bypass. Generate with:
# openssl rand -base64 48
SYSTEM_API_KEY=

# CORS (comma-separated origin allowlist; no "*" in prod)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Pagination — list endpoints. Defaults are returned when `limit` is omitted;
# requests above MAX are clamped down. MAX is hard-capped at 500 by config validation.
COMPLAINTS_PAGE_DEFAULT=50
COMPLAINTS_PAGE_MAX=200
# ENTITIES_PAGE_* governs /v1/entities/filter (typeahead) — small pages for dropdowns.
ENTITIES_PAGE_DEFAULT=20
ENTITIES_PAGE_MAX=100
# ENTITY_LIST_PAGE_* governs /v1/entities (full list with counts). Kept small
# because each page triggers a per-complaint $lookup into tr_complaints for
# escalation counts.
ENTITY_LIST_PAGE_DEFAULT=20
ENTITY_LIST_PAGE_MAX=50
# DASHBOARD_SUBCAT_LIMIT_* caps the top-N rows returned by
# /v1/dashboard/volume-by-subcategory.
DASHBOARD_SUBCAT_LIMIT_DEFAULT=50
DASHBOARD_SUBCAT_LIMIT_MAX=200
