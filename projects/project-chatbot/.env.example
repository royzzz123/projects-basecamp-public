# Local dev — copy to .env and fill in values.
# For SEBI VM deployment use bare-metal/sebi-chat.env.example instead.

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://root:<password>@localhost:27017/?authSource=admin&directConnection=true
MONGO_DB=SEBI-project

# ── LLM (same env var names as project-ai) ──────────────────────────────
# Local dev: point at the OnFinance LiteLLM gateway (kubectl port-forward)
LLM_LLAMA_70B_URL=http://localhost:4000/v1/chat/completions
LLM_LLAMA_70B_BEARER_TOKEN=replace-me
LLM_LLAMA_70B_MODEL_ID=bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_HTTP_PROXY=
LLM_VERIFY_SSL=true

# ── App ───────────────────────────────────────────────────────────────────────
APP_PORT=3001
