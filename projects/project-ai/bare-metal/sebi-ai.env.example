# Template for sebi-ai.env — copy this to `sebi-ai.env` and fill in real values.
#
# Used by docker-compose in two ways:
#   1. `env_file: - sebi-ai.env` (per service) → injected into the container.
#      The FastAPI app reads via pydantic-settings.
#   2. `--env-file sebi-ai.env` (CLI flag) → ${VAR} interpolation inside
#      docker-compose.yml (ports, container_name).
#
# Bring the stack up with:
#     docker compose --env-file sebi-ai.env up -d

# ── Shared: ports & inter-container hostnames ────────────────────────────────
AI_HOST=sebi-ai
APP_PORT=9000

# ── CRUD backend ─────────────────────────────────────────────────────────────
# If CRUD runs in the same docker-compose stack as the frontend (the
# project-crud bare-metal compose binds container_name=sebi-crud), use
# that container name. Otherwise point at the CRUD VM's host:port directly.
CRUD_BASE_URL=http://<crud-host>:8080
CRUD_SYSTEM_KEY=replace-with-same-SYSTEM_API_KEY-set-on-the-crud-service

# ── MinIO (public bucket) ────────────────────────────────────────────────────
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_SECURE=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── LLM backends (CDAC AIRawat) ──────────────────────────────────────────────
LLM_BEARER_TOKEN=replace-with-cdac-airawat-bearer-token
LLM_NEMOTRON_NANO_URL=https://apis.airawat.cdac.in/msebisec-nemotron/api/generate
LLM_NEMOTRON_120B_URL=https://apis.airawat.cdac.in/msebisec/nemotron3-120bbf16/v1/chat/completions
LLM_LIGHTON_OCR_URL=https://apis.airawat.cdac.in/msebisec-lightonocr-bbox/v1/chat/completions
LLM_GEMMA_URL=https://apis.airawat.cdac.in/msebisec/gemma4-26b/v1/chat/completions
LLM_LLAMA_70B_URL=https://apis.airawat.cdac.in/sebi/llama70b/v1/chat/completions
LLM_MINISTRAL_URL=https://apis.airawat.cdac.in/msebisec-ministral/api/generate

# Llama-3.3-70B uses a SEPARATE bearer token (different issuer from the rest)
LLM_LLAMA_70B_BEARER_TOKEN=replace-with-llama-70b-bearer-token

# Model IDs (the value put in the JSON "model" field of each request)
LLM_NEMOTRON_NANO_MODEL_ID=nemotron-3-nano:30b-a3b-q4_K_M
LLM_NEMOTRON_120B_MODEL_ID=nvidia/nemotron-3-super
LLM_LIGHTON_OCR_MODEL_ID=lightonai/LightOnOCR-2-1B-bbox
LLM_GEMMA_MODEL_ID=gemma-4-26b-aa4b-it
LLM_LLAMA_70B_MODEL_ID=meta/llama-3.3-70b-instruct
LLM_MINISTRAL_MODEL_ID=ministral-3:14b-instruct-2512-q8_0

# Outbound proxy for LLM calls (VM has no direct internet). Leave empty for
# local dev with direct internet.
LLM_HTTP_PROXY=http://10.201.6.100:1080

# SSL verification for LLM endpoints (CDAC certs may not be in VM trust store).
LLM_VERIFY_SSL=false

# HTTP
HTTP_TIMEOUT_SECONDS=120
