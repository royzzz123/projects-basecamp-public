# ─────────────────────────────────────────────────────────────────────────────
# SEBI bare-metal env file (NOT named .env on purpose — keeps it isolated from
# the shared /opt/.env used by your other services on this VM).
#
# This file is used TWO ways by docker-compose:
#   1. `env_file: - sebi.env` (in each service) → injected into the container.
#      The backend reads them via the Go config loader; the frontend's nginx
#      reads them via envsubst on /etc/nginx/templates/*.template at startup.
#   2. `--env-file sebi.env` (CLI flag) → used for ${VAR} interpolation in
#      docker-compose.yml itself (host port mappings, container_name).
#
# Bring the stack up with:
#     docker compose --env-file sebi.env up -d
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared: ports & inter-container hostnames ────────────────────────────────
# FRONTEND_PORT  → nginx listen port (and host-side port mapping).
# HTTP_PORT      → backend Go server listen port AND the port the frontend
#                  nginx proxies to. Same value in both places by design.
# BACKEND_HOST   → docker DNS name the frontend's nginx resolves for the
#                  backend container. Must match the backend service's
#                  container_name in docker-compose.yml (which interpolates
#                  this same var).
FRONTEND_PORT=3000
BACKEND_HOST=sebi-crud
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET=sebi-complaints

# AI_HOST / AI_PORT are the upstream the frontend's nginx forwards /ai/ to.
# Frontend JS calls /ai/<endpoint> (same-origin), nginx strips /ai/ and proxies
# to ${AI_HOST}:${AI_PORT}. Change these to point at the AI service VM/host —
# no image rebuild required, just `docker compose up -d` to pick up the change.
AI_HOST=ai-backend
AI_PORT=9000

# ── Backend: application ─────────────────────────────────────────────────────
ENV=prod
HTTP_PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s

# ── Backend: MongoDB ─────────────────────────────────────────────────────────
# Reuses the shared Mongo cluster (infra VM 10.102.44.4:27017). The SEBI
# backend container reaches it directly over the docker bridge — no
# host.docker.internal needed because Mongo isn't on the same VM.
# MONGO_DB is SEBI-specific (separate database in the same cluster).
MONGO_URI=mongodb://admin:CHANGE_ME@10.102.44.4:27017/?socketTimeoutMS=300000&connectTimeoutMS=30000&serverSelectionTimeoutMS=300000&maxPoolSize=20
MONGO_DB=SEBI-project

# ── Backend: JWT (HS256, secret >= 32 bytes) ─────────────────────────────────
# Dedicated SEBI secret — intentionally NOT the same as the shared JWT_SECRET
# in /opt/.env, so SEBI tokens are isolated from your other services.
# Rotate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-real-jwt-secret
JWT_ISSUER=sebi-crud
JWT_TTL=24h

# ── Backend: System-to-system shared secret ──────────────────────────────────
# When set, any /v1 request carrying `X-System-Key: <value>` bypasses JWT +
# role checks. Intended for trusted internal callers (e.g. the AI backend
# that POSTs to /v1/complaint-workflow-analysis). Rotate with:
# openssl rand -base64 48
SYSTEM_API_KEY=replace-me-with-a-system-api-key

# ── Backend: CORS ────────────────────────────────────────────────────────────
# Browser-facing origins for the SEBI frontend. Assumes SEBI runs on the app
# VM (10.102.44.3) on port 3000. Adjust if the VM is different.
CORS_ORIGINS=http://localhost:3000,http://10.102.44.3:3000

# ── Backend: pagination ──────────────────────────────────────────────────────
COMPLAINTS_PAGE_DEFAULT=50
COMPLAINTS_PAGE_MAX=200
# ENTITIES_* = typeahead (/v1/entities/filter); ENTITY_LIST_* = full table (/v1/entities)
ENTITIES_PAGE_DEFAULT=20
ENTITIES_PAGE_MAX=100
ENTITY_LIST_PAGE_DEFAULT=50
ENTITY_LIST_PAGE_MAX=200
