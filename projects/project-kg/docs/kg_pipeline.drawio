<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="KG-Construction-Pipeline" id="kg-pipeline-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== stage backdrops (behind everything) ===== -->
        <mxCell id="bg1" value="" style="rounded=1;fillColor=#eef4fc;strokeColor=#cfe0f5;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1520" height="250" as="geometry"/></mxCell>
        <mxCell id="bg2" value="" style="rounded=1;fillColor=#eefaf0;strokeColor=#cfebd6;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1520" height="490" as="geometry"/></mxCell>
        <mxCell id="bg3" value="" style="rounded=1;fillColor=#f5f0fa;strokeColor=#ddccec;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1520" height="270" as="geometry"/></mxCell>
        <mxCell id="bg4" value="" style="rounded=1;fillColor=#fdf9ec;strokeColor=#ece0b8;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="1520" height="320" as="geometry"/></mxCell>
        <mxCell id="bg5" value="" style="rounded=1;fillColor=#fdeeee;strokeColor=#f0cfcf;" vertex="1" parent="1"><mxGeometry x="40" y="1510" width="1520" height="150" as="geometry"/></mxCell>

        <!-- ===== title ===== -->
        <mxCell id="title" value="&lt;b&gt;SEBI SCORES Auto-Escalation — Knowledge-Graph Construction Pipeline&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Complaint structure → triplet prompt → ingestion into Neo4j → ontology&lt;/font&gt;" style="text;html=1;align=center;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1520" height="40" as="geometry"/></mxCell>

        <!-- ===== STAGE 1 : complaint structure ===== -->
        <mxCell id="s1title" value="&lt;b&gt;1 · COMPLAINT STRUCTURE&lt;/b&gt;  —  MongoDB (READ-ONLY source)" style="text;html=1;align=left;fontSize=14;fontColor=#2a5a9e;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="700" height="24" as="geometry"/></mxCell>
        <mxCell id="s1_tt" value="&lt;b&gt;tt_complaints&lt;/b&gt; (17,132)&lt;br&gt;&lt;br&gt;complaintid&lt;br&gt;complaint_details  &lt;i&gt;(free text)&lt;/i&gt;&lt;br&gt;complaint_category → cat code&lt;br&gt;complaint_sub_category&lt;br&gt;entityscreenid → RE&lt;br&gt;complaint_code → state / district&lt;br&gt;created_date · wfstate · status" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="106" width="340" height="188" as="geometry"/></mxCell>
        <mxCell id="s1_tr" value="&lt;b&gt;tr_complaints&lt;/b&gt; (135,505)&lt;br&gt;&lt;br&gt;per-complaint workflow log&lt;br&gt;action (ATR, REMINDER,&lt;br&gt;  FIRST / SECOND_LEVEL_REVIEW…)&lt;br&gt;remarks = ATR text&lt;br&gt;wfstate · role · doc_url" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="106" width="340" height="188" as="geometry"/></mxCell>
        <mxCell id="s1_master" value="&lt;b&gt;entity_master&lt;/b&gt; (20,769)&lt;br&gt;userid · name · entitytype ·&lt;br&gt;categorycode · complaint_count&lt;br&gt;&lt;br&gt;&lt;b&gt;category_master&lt;/b&gt; (35)&lt;br&gt;&lt;b&gt;subcategory_master&lt;/b&gt; (223)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="106" width="320" height="188" as="geometry"/></mxCell>
        <mxCell id="s1_sig" value="&lt;b&gt;Significance&lt;/b&gt;&lt;br&gt;&lt;br&gt;Raw SEBI SCORES records. The KG is a &lt;b&gt;read-only consumer&lt;/b&gt; — it never writes back, so no other service is affected.&lt;br&gt;&lt;br&gt;Only &lt;b&gt;complaint_details&lt;/b&gt; is unstructured; everything else is structured foreign keys." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="106" width="420" height="188" as="geometry"/></mxCell>

        <!-- ===== STAGE 2 : triple generation ===== -->
        <mxCell id="s2title" value="&lt;b&gt;2 · TRIPLE GENERATION&lt;/b&gt;  (subject → predicate → object)  —  HYBRID: deterministic + LLM" style="text;html=1;align=left;fontSize=14;fontColor=#3a7a3a;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="1000" height="24" as="geometry"/></mxCell>

        <!-- lane B1 : deterministic -->
        <mxCell id="laneB1" value="" style="rounded=1;html=1;dashed=1;fillColor=#f4fbf4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="384" width="560" height="430" as="geometry"/></mxCell>
        <mxCell id="b1title" value="&lt;b&gt;LAYER 1 · Deterministic ETL — NO AI&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontColor=#3a7a3a;" vertex="1" parent="1"><mxGeometry x="74" y="392" width="530" height="20" as="geometry"/></mxCell>
        <mxCell id="b1desc" value="Structural triples read &lt;b&gt;directly from DB fields&lt;/b&gt; — exact, cheap, zero hallucination. An LLM is deliberately &lt;b&gt;NOT&lt;/b&gt; used where a foreign key already gives the answer." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="74" y="418" width="532" height="78" as="geometry"/></mxCell>
        <mxCell id="b1triples" value="(Complaint) —[:FILED_AGAINST]→ (Entity)&lt;br&gt;   ← entityscreenid&lt;br&gt;(Complaint) —[:IN_CATEGORY]→ (Category)&lt;br&gt;   ← complaint_category&lt;br&gt;(Complaint) —[:IN_SUBCATEGORY]→ (SubCategory)&lt;br&gt;(Complaint) —[:FILED_BY]→ (Investor)&lt;br&gt;   ← complainant_id  (SHA-256 hashed)&lt;br&gt;(Complaint) —[:LOCATED_IN]→ (Location)&lt;br&gt;   ← parsed from complaint_code&lt;br&gt;(Complaint) —[:HAS_EVENT]→ (TimelineEvent)&lt;br&gt;   ← tr_complaints rows" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="74" y="504" width="532" height="298" as="geometry"/></mxCell>

        <!-- lane B2 : LLM prompt -->
        <mxCell id="laneB2" value="" style="rounded=1;html=1;dashed=1;fillColor=#fff9f0;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="648" y="384" width="892" height="430" as="geometry"/></mxCell>
        <mxCell id="b2title" value="&lt;b&gt;LAYER 2 · LLM Enrichment — the PROMPT&lt;/b&gt;  (reads complaint_details)" style="text;html=1;align=left;fontSize=12;fontColor=#b06a00;" vertex="1" parent="1"><mxGeometry x="662" y="392" width="860" height="20" as="geometry"/></mxCell>
        <mxCell id="b2model" value="&lt;b&gt;Model:&lt;/b&gt; Claude Haiku 4.5 via local &lt;b&gt;Claude Code CLI&lt;/b&gt; (headless, JSON output, batched 12 complaints per call). Input = complaint_details (+ category)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="662" y="418" width="864" height="48" as="geometry"/></mxCell>
        <mxCell id="b2sys" value="&lt;b&gt;SYSTEM PROMPT&lt;/b&gt;&lt;br&gt;&quot;You are a SEBI SCORES systemic-risk analyst applying the Systemic-Criticality Auto-Escalation Framework. For EACH complaint, extract structured signals based &lt;b&gt;ONLY&lt;/b&gt; on that complaint's text; when a signal is absent use the conservative default (false / none / null). &lt;b&gt;Never invent&lt;/b&gt; amounts or allegations. Output a strict JSON array — one object per complaint.&quot;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="662" y="472" width="864" height="104" as="geometry"/></mxCell>
        <mxCell id="b2user" value="&lt;b&gt;USER PROMPT (per batch)&lt;/b&gt;&lt;br&gt;• the complaints as a JSON array&lt;br&gt;• required output keys: &lt;i&gt;severity, typology, typology_confidence, amount_inr, liquidity_block, is_misappropriation, class_harm_assertion, vulnerable + flags, market_integrity_risk, distress, criminal_language, senior_mgmt_allegation, products[], evidence_quote, reasoning&lt;/i&gt;&lt;br&gt;• &lt;b&gt;controlled typology list&lt;/b&gt; — Grave / High / Moderate library; the model must copy the closest label&lt;br&gt;• &lt;b&gt;strict rules&lt;/b&gt; — e.g. class-harm only if a group is named; amounts only if a figure is stated" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="662" y="582" width="864" height="150" as="geometry"/></mxCell>
        <mxCell id="b2out" value="&lt;b&gt;LLM OUTPUT →&lt;/b&gt; strict JSON per complaint (the semantic signals + evidence). Severity is then reconciled &lt;b&gt;deterministically&lt;/b&gt; from the chosen typology (framework fixes each typology's severity)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="662" y="740" width="864" height="66" as="geometry"/></mxCell>

        <!-- ===== STAGE 3 : ingestion ===== -->
        <mxCell id="s3title" value="&lt;b&gt;3 · INGESTION → Neo4j&lt;/b&gt;  (batched, idempotent Cypher)" style="text;html=1;align=left;fontSize=14;fontColor=#7a4f9e;" vertex="1" parent="1"><mxGeometry x="60" y="870" width="700" height="24" as="geometry"/></mxCell>
        <mxCell id="s3_etl" value="&lt;b&gt;ETL loader&lt;/b&gt;  (etl/loader.py)&lt;br&gt;&lt;br&gt;Batched &lt;b&gt;UNWIND … MERGE&lt;/b&gt; Cypher.&lt;br&gt;Creates the structural nodes:&lt;br&gt;Complaint · Entity · Category ·&lt;br&gt;SubCategory · Investor · Location ·&lt;br&gt;TimelineEvent&lt;br&gt;+ all Layer-1 relationships." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="905" width="430" height="200" as="geometry"/></mxCell>
        <mxCell id="s3_writer" value="&lt;b&gt;Enrichment writer&lt;/b&gt;  (enrichment/writer.py)&lt;br&gt;&lt;br&gt;Per complaint:&lt;br&gt;• SET signal properties on Complaint&lt;br&gt;• MERGE (Complaint)—[:ALLEGES]→(Typology)&lt;br&gt;• MERGE (Complaint)—[:IMPLICATES]→(Product)&lt;br&gt;&lt;br&gt;→ the &lt;b&gt;AI-derived semantic triples&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="905" width="430" height="200" as="geometry"/></mxCell>
        <mxCell id="s3_cypher" value="&lt;b&gt;Example Cypher&lt;/b&gt;&lt;br&gt;UNWIND $rows AS r&lt;br&gt;MATCH (c:Complaint {complaintid:r.id})&lt;br&gt;SET c.severity=r.severity, c.amount_inr=r.amt …&lt;br&gt;MERGE (ty:Typology {name:r.typology})&lt;br&gt;MERGE (c)—[:ALLEGES]→(ty)&lt;br&gt;&lt;br&gt;&lt;i&gt;MERGE-based → idempotent, re-runnable &amp; resumable.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="980" y="905" width="560" height="200" as="geometry"/></mxCell>

        <!-- ===== STAGE 4 : ontology ===== -->
        <mxCell id="s4title" value="&lt;b&gt;4 · ONTOLOGY&lt;/b&gt;  —  the graph schema (store of record)" style="text;html=1;align=left;fontSize=14;fontColor=#a68a1e;" vertex="1" parent="1"><mxGeometry x="60" y="1170" width="700" height="24" as="geometry"/></mxCell>
        <mxCell id="s4_nodes" value="&lt;b&gt;Node labels (11)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Complaint · Entity · Investor ·&lt;br&gt;Category · SubCategory ·&lt;br&gt;Location · TimelineEvent ·&lt;br&gt;&lt;b&gt;Typology&lt;/b&gt; · &lt;b&gt;Product&lt;/b&gt; ·&lt;br&gt;&lt;b&gt;Cluster&lt;/b&gt; · MarketEvent" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1205" width="360" height="250" as="geometry"/></mxCell>
        <mxCell id="s4_rels" value="&lt;b&gt;Relationship types (predicates)&lt;/b&gt;&lt;br&gt;&lt;br&gt;FILED_AGAINST · FILED_BY ·&lt;br&gt;IN_CATEGORY · IN_SUBCATEGORY ·&lt;br&gt;LOCATED_IN · HAS_EVENT ·&lt;br&gt;&lt;b&gt;ALLEGES&lt;/b&gt; · &lt;b&gt;IMPLICATES&lt;/b&gt; ·&lt;br&gt;&lt;b&gt;SIMILAR_TO&lt;/b&gt; · &lt;b&gt;MEMBER_OF&lt;/b&gt; ·&lt;br&gt;AGAINST · ON_PRODUCT" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1205" width="360" height="250" as="geometry"/></mxCell>
        <mxCell id="s4_const" value="&lt;b&gt;Constraints + indexes&lt;/b&gt;&lt;br&gt;(graph/ontology.py)&lt;br&gt;&lt;br&gt;UNIQUE on each node key&lt;br&gt;(complaintid, screenid, …)&lt;br&gt;&lt;br&gt;indexes on scs · tier ·&lt;br&gt;created_date · category" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="1205" width="290" height="250" as="geometry"/></mxCell>
        <mxCell id="s4_sig" value="&lt;b&gt;Significance — why an ontology?&lt;/b&gt;&lt;br&gt;&lt;br&gt;A &lt;b&gt;controlled vocabulary&lt;/b&gt; of node labels + predicates. Because typology / product / etc. are pinned to fixed types, the free-text signals &lt;b&gt;aggregate into the 11 KPI dimensions&lt;/b&gt; and are queryable in Cypher.&lt;br&gt;&lt;br&gt;Open-ended LLM triples (&quot;money_blocked&quot;, &quot;refund_not_received&quot;) could never be counted; the ontology makes them &lt;b&gt;AI-powered AND countable&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1130" y="1205" width="410" height="250" as="geometry"/></mxCell>

        <!-- ===== STAGE 5 : downstream ===== -->
        <mxCell id="s5title" value="&lt;b&gt;5 · DOWNSTREAM&lt;/b&gt;  (what the graph powers)" style="text;html=1;align=left;fontSize=14;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="1520" width="700" height="24" as="geometry"/></mxCell>
        <mxCell id="s5_flow" value="Semantic Clustering (TF-IDF → &lt;b&gt;SIMILAR_TO&lt;/b&gt; edges + &lt;b&gt;Cluster&lt;/b&gt; nodes)&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;SCS Scoring (11 dimensions · hard-triggers · tier bands · config-driven)&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;/kg API&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;/autoescalation dashboard (graph + queue + analytics)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1552" width="1480" height="86" as="geometry"/></mxCell>

        <!-- ===== edges ===== -->
        <mxCell id="e1" value="structured FKs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5a5a5a;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="s1_tt" target="b1triples"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="complaint_details (free text)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#d79b00;fontSize=10;fontColor=#b06a00;" edge="1" parent="1" source="s1_tt" target="b2model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="HAS_EVENT / ATR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5a5a5a;fontSize=10;fontColor=#333333;" edge="1" parent="1" source="s1_tr" target="b1triples"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Layer-1 triples" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#82b366;fontSize=10;fontColor=#3a7a3a;" edge="1" parent="1" source="b1triples" target="s3_etl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="JSON signals" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#82b366;fontSize=10;fontColor=#3a7a3a;" edge="1" parent="1" source="b2out" target="s3_writer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="MERGE nodes + structural edges" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;fontSize=10;fontColor=#7a4f9e;" edge="1" parent="1" source="s3_etl" target="s4_nodes"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="ALLEGES / IMPLICATES + props" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;fontSize=10;fontColor=#7a4f9e;" edge="1" parent="1" source="s3_writer" target="s4_rels"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="ontology-enforced graph" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;fontSize=10;fontColor=#b85450;" edge="1" parent="1" source="s4_const" target="s5_flow"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
