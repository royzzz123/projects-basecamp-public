# ── MongoDB (READ-ONLY source of complaint data) ──────────────────────────
# The KG service never writes to Mongo. It reads tt_complaints / tr_complaints /
# entity_master / category_master / subcategory_master and projects them into Neo4j.
MONGO_URI=mongodb://root:CHANGE_ME@localhost:27017/?directConnection=true
MONGO_DB=SEBI-project

# ── Neo4j (store of record for the knowledge graph + SCS scores) ───────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# ── Inference backend (Phase 2 dimension enrichment) ──────────────────────
# claude_cli = local Claude Code headless (no gateway/key); gateway = LiteLLM.
INFERENCE_BACKEND=claude_cli
CLAUDE_MODEL=claude-haiku-4-5-20251001
ENRICH_BATCH_SIZE=12
ENRICH_WORKERS=5

# ── LLM gateway (fallback backend, e.g. SEBI VM where the CLI is unavailable) ─
LLM_BEARER_TOKEN=CHANGE_ME
LLM_NEMOTRON_120B_URL=http://localhost:9007/v1/chat/completions
LLM_NEMOTRON_120B_MODEL_ID=bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_HTTP_PROXY=
LLM_VERIFY_SSL=true
ENRICHMENT_MODEL=nemotron-3-120b
ENRICHMENT_MAX_TOKENS=1200

# ── HTTP / app ────────────────────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=120
APP_PORT=9010

# ── ETL batch sizes ───────────────────────────────────────────────────────
ETL_BATCH_COMPLAINTS=2000
ETL_BATCH_EVENTS=5000
